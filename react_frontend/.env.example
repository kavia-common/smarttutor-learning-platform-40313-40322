# React (Vite) environment example for SmartTutor
# Copy to .env and adjust values for your environment.

# Base URL for REST API (Flask backend). Include /api suffix if backend routes are prefixed.
VITE_API_BASE_URL=http://localhost:8000/api

# Base URL for WebSocket endpoints (if used). Typically ws://localhost:8000 or wss://<host>.
VITE_WS_BASE_URL=ws://localhost:8000

# Stripe publishable key (frontend)
VITE_STRIPE_PK=pk_test_change_me
