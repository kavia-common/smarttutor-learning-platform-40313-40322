# PUBLIC_INTERFACE
# Environment variables required by the React frontend.
# Copy this file to .env and set values for your environment.

# Base URL for REST API (Flask backend), e.g., http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000

# Base URL for WebSocket server, e.g., ws://localhost:8000/ws
VITE_WS_BASE_URL=ws://localhost:8000

# Stripe publishable key for frontend
VITE_STRIPE_PK=pk_test_xxxxxxxxxxxxxxxxxxxxx
