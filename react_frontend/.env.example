# SmartTutor Flutter .env example
# Copy to .env and adjust as needed. Do not commit secrets.

# Flask backend base URL (without trailing slash)
API_BASE_URL=http://localhost:5001

# SocketIO/WebSocket base URL
WS_BASE_URL=ws://localhost:5001

# Use mocks by default? Set to false to use real backend.
FEATURE_USE_MOCKS=false

# Optional Stripe publishable key if payments are wired to Stripe on backend
STRIPE_PUBLISHABLE_KEY=
