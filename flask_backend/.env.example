# REQUIRED: PostgreSQL SQLAlchemy URL (SQLAlchemy 2.x syntax)
# Example: postgresql+psycopg://postgres:password@localhost:5432/smarttutor
# If using docker-compose.yml (service name 'db'), you can use host 'db':
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/smarttutor
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/smarttutor
# For quick local smoke tests without Postgres, you can temporarily use SQLite (not for prod):
# DATABASE_URL=sqlite:///smarttutor.db

# REQUIRED: Secret for signing JWTs
JWT_SECRET=change_me_please_use_a_long_random_value

# OPTIONAL: Version string surfaced in diagnostics and headers
APP_VERSION=0.1.0

# Optional: comma-separated origins allowed via CORS for /api/*
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Optional: Backend port (used by wsgi.py and readiness checks)
PORT=8000

# Optional: Comma-separated CORS origins (defaults to allow-all in dev)
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=

# Optional: Log level (DEBUG, INFO, WARNING, ERROR). DEBUG logs requests.
LOG_LEVEL=INFO

# Optional: Password pepper to strengthen hashing (dev utility in app/security.py)
PWD_PEPPER=
