# Backend environment variables for SmartTutor

# Database URL (PostgreSQL recommended)
# Example: postgresql+psycopg://postgres:password@localhost:5432/smarttutor
DATABASE_URL=sqlite:///smarttutor.db

# Secret for JWT tokens (not yet used in this demo auth; planned upgrade)
JWT_SECRET=dev_only_secret_change_me

# Stripe secret key for payment intents (required for /api/payments/intent)
# Obtain from Stripe dashboard. Do NOT commit actual secret.
STRIPE_SK=sk_test_change_me
