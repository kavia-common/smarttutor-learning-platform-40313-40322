# Copy this file to .env before running the backend.
# PostgreSQL URL using SQLAlchemy 2.x with psycopg driver:
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smarttutor

# A long random secret string used for signing JWTs
JWT_SECRET=please_replace_with_a_long_random_secret_value

# Optional: port to run the development server
PORT=8000
